# ─────────────────────────────────────────────────────────────────
# Naturalist — Environment Variables Template
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local or any file containing real secrets to git.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# All other variables remain server-side only.
# ─────────────────────────────────────────────────────────────────

# ── SERVER CONFIGURATION ─────────────────────────────────────────
NODE_ENV=development

# The public base URL of your application (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "true" to bypass real DB auth in local development.
# Must be "false" or removed in production.
NEXT_PUBLIC_MOCK_AUTH=false

# Required by Auth.js / NextAuth
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# ── DATABASE ─────────────────────────────────────────────────────
# MongoDB connection string (Atlas or local). Keep this server-side only.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── AUTHENTICATION (Auth.js v5 / NextAuth) ───────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=<generate-a-secure-random-string>

# Legacy NextAuth secret — keep aligned with AUTH_SECRET
NEXTAUTH_SECRET=<same-or-different-secure-random-string>

# Google OAuth credentials
# Create at: https://console.developers.google.com/
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# ── EMAIL SERVICE ────────────────────────────────────────────────
# Primary: Resend (https://resend.com)
RESEND_API_KEY=re_<your-resend-api-key>

# The "From" address for outgoing emails — must be verified with Resend
EMAIL_FROM=hello@yourdomain.com
EMAIL_FROM_NAME=Naturalist

# Primary fallback/bypasser for Render: Gmail API Refresh Token
# Generate this using scripts/get-gmail-refresh-token.ts
GMAIL_REFRESH_TOKEN=

# Fallback SMTP (optional — for local development with Mailtrap etc.)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

# ── CLOUDINARY (Image CDN) ───────────────────────────────────────
# Find these in your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
# Keep the API secret server-side only — never prefix with NEXT_PUBLIC_
CLOUDINARY_API_SECRET=<your-api-secret>

# ── STRIPE PAYMENTS ──────────────────────────────────────────────
# Use test keys in development, live keys in production only
STRIPE_SECRET_KEY=sk_test_<your-stripe-secret-key>
# This key IS safe to expose — it goes to the browser for Stripe.js
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<your-stripe-publishable-key>
# Webhook secret from your Stripe dashboard endpoint settings
STRIPE_WEBHOOK_SECRET=whsec_<your-webhook-secret>

# ── ADMIN CONFIGURATION ──────────────────────────────────────────
# The email address that receives admin role automatically
ADMIN_EMAIL=admin@yourdomain.com
# Only used when NEXT_PUBLIC_MOCK_AUTH=true (local dev bypass)
ADMIN_SEED_PASSWORD=<secure-local-dev-admin-password>
USER_SEED_PASSWORD=<secure-local-dev-user-password>
