# SERVER CONFIGURATION
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# DATABASE
MONGODB_URI=mongodb://localhost:27017/naturalist
SOURCE_MONGODB_URI=mongodb://localhost:27017/naturalist
ATLAS_MONGODB_URI=mongodb+srv://naturalist_project:<password>@<cluster>/<database>?retryWrites=true&w=majority

# AUTH.JS V5 (NEXTAUTH)
# Run `npx auth secret` or generate a 32-character random string
AUTH_SECRET=your-auth-secret

# EMAIL SERVICE (RESEND & SMTP FALLBACK)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=your-email@example.com
EMAIL_FROM_NAME=Naturalist Team

# SMTP FALLBACK CONFIGURATION (Optional, if Resend is not set up)
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# CLOUDINARY (for proxied image uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# STRIPE PAYMENTS
STRIPE_SECRET_KEY=your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# ADMIN ACCOUNT INITIAL CONFIG
ADMIN_EMAIL=admin@example.com
